# ──────────────────────────────────────────────
# DRI Multi-Agent System — Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# === LLM Provider ===
# Choose which LLM provider to use: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# === Gemini (Google AI Studio) ===
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# CEO uses the most capable model; other agents default to same pro model
GEMINI_ROOT_MODEL=gemini-2.5-pro-preview-05-06
GEMINI_DEFAULT_MODEL=gemini-2.5-pro-preview-05-06
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash-preview-04-17

# === Anthropic Claude (optional — only needed if LLM_PROVIDER=anthropic) ===
ANTHROPIC_API_KEY=
ANTHROPIC_ROOT_MODEL=claude-opus-4-7
# ANTHROPIC_ROOT_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# === Common LLM settings ===
# Max tokens per single LLM response
MAX_TOKENS_PER_RESPONSE=8192

# === Budget ===
# Total token budget per user session (input + output combined)
# 5M recommended: web dev tasks (scaffold + build + fix) need 12+ LLM rounds per worker.
# Each round costs ~35k tokens (25k system prompt + history + output) with Gemini Flash.
# With 5M: 3 parallel shell workers × 500k each = 1.5M, leaves plenty for CEO + synthesis.
BUDGET_MAX_TOKENS_PER_SESSION=5000000
# Fraction of parent's budget allocated to each child by default (0.0 to 1.0)
# Keep at 0.7+ — lower values starve nested agents (0.4 = only 6 LLM rounds for workers)
BUDGET_CHILD_DEFAULT_SHARE=0.7
# When remaining budget drops below this fraction, child alerts parent
BUDGET_WARNING_THRESHOLD=0.2

# === Tools (optional) ===
# At least one search API key is needed for web_search tool
TAVILY_API_KEY=
BRAVE_API_KEY=

# ============================================================
# === Real-World Connectors (for executing approved actions) =
# ============================================================

# --- Connector: linkedin_message / social_post (LinkedIn) ---
# Posts to your LinkedIn feed or attempts DMs via the LinkedIn API.
# action_type="social_post" with "linkedin" in recipient → posts to your feed.
# action_type="linkedin_message" → requires LinkedIn Partner API (see connector docs).
#
# Setup (one-time, token valid 60 days):
#   1. Create a LinkedIn Developer App: https://www.linkedin.com/developers/apps
#      - Add products: "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect"
#      - OAuth 2.0 scopes needed: openid, profile, w_member_social
#   2. Use the OAuth 2.0 token generator tool on the Developer portal (Auth tab)
#      to get an access token for your own account.
#   3. Paste the token below. To find your Person URN, call:
#      curl -H "Authorization: Bearer <token>" https://api.linkedin.com/v2/userinfo
#      and copy the "sub" field — leave LINKEDIN_PERSON_URN empty to auto-fetch.
LINKEDIN_ACCESS_TOKEN=          # OAuth 2.0 access token (valid 60 days)
LINKEDIN_PERSON_URN=            # Optional — e.g. urn:li:person:ABC123 (auto-fetched if empty)

# --- Connector: email (SendGrid — takes priority over SMTP when configured) ---
# Better deliverability than direct SMTP. If SENDGRID_API_KEY is set,
# SendGrid handles all action_type="email" actions instead of SMTP.
# Setup:
#   1. Sign up at https://sendgrid.com (free tier: 100 emails/day)
#   2. Settings → API Keys → Create API Key (Full Access or Mail Send)
#   3. Verify your sender email: Settings → Sender Authentication
SENDGRID_API_KEY=               # SG...
SENDGRID_FROM_EMAIL=            # must be a verified sender in your SendGrid account
SENDGRID_FROM_NAME=DRI Agent    # display name shown to recipients

# --- Connector: sms ---
# Sends real SMS messages via Twilio when an agent's approved action has action_type="sms".
# Setup:
#   1. Sign up at https://www.twilio.com and get a phone number
#   2. Copy your Account SID and Auth Token from the Console Dashboard
#   3. TWILIO_FROM_NUMBER must be in E.164 format: +12125551234
TWILIO_ACCOUNT_SID=             # AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # +E.164 format, e.g. +12125551234

# --- Connector: slack_message / webhook (Slack channel) ---
# Posts to Slack via the Web API (more powerful than incoming webhooks).
# Agents can use action_type="slack_message" with recipient=#channel-name or a channel/user ID.
# Slack app setup:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. Add OAuth scope: chat:write  (Bot Token Scopes)
#   3. Install to workspace → copy the Bot User OAuth Token (xoxb-...)
#   4. Invite the bot to your channel: /invite @your-bot-name
SLACK_BOT_TOKEN=               # xoxb-...
SLACK_DEFAULT_CHANNEL=         # Optional — fallback channel (e.g. #general)

# --- Connector: email ---
# Sends real emails when an agent's approved action has action_type="email".
# Gmail setup:
#   1. Enable 2FA on your Google account
#   2. myaccount.google.com → Security → App passwords → create one
#   3. Paste the 16-char app password as SMTP_PASSWORD
# Outlook/Hotmail: use smtp.office365.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                    # Optional — defaults to SMTP_USER

# --- Connector: github_push / github_create_pr / github_create_repo ---
# Pushes files, opens PRs, or creates repositories via the GitHub REST API.
# Setup:
#   1. github.com/settings/tokens → Generate new token (classic or fine-grained)
#   2. Required scopes: repo (full control, incl. private repos)
#                  or: public_repo (public repos only)
#   3. Paste the token below.
# Action types enabled: github_push, github_create_pr, github_create_repo
GITHUB_TOKEN=           # ghp_...

# --- Connector: youtube_upload / youtube_create_playlist ---
# Uploads MP4 videos and creates playlists on YouTube via the Data API v3.
# Videos are uploaded as PRIVATE by default — founder controls visibility.
# Setup (one-time OAuth2):
#   1. Google Cloud Console → Create / select project
#   2. Enable "YouTube Data API v3"
#   3. Credentials → Create OAuth 2.0 Client ID (Desktop App type)
#   4. Download client_secret JSON; extract client_id and client_secret
#   5. Run one-time auth flow to obtain refresh token:
#      python -m dri.tools.youtube_auth  (or use Google OAuth Playground)
#   6. Scopes needed: https://www.googleapis.com/auth/youtube.upload
#                     https://www.googleapis.com/auth/youtube
# YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your_client_secret
# YOUTUBE_REFRESH_TOKEN=your_refresh_token

# --- Connector: webhook ---
# Sends a real HTTP POST when an approved action has action_type="webhook"
# (or social_post/outreach_message with a webhook URL as recipient).
# No global config needed — the webhook URL is set per-action in `recipient`.
#
# Supported platforms (auto-detected from URL):
#   Slack incoming webhook:  https://hooks.slack.com/services/...
#   Discord webhook:         https://discord.com/api/webhooks/...
#   Make.com:                https://hook.eu1.make.com/...
#   Zapier:                  https://hooks.zapier.com/hooks/catch/...
#   n8n:                     https://your-n8n.com/webhook/...
#   Any custom HTTP endpoint: any https:// URL that accepts POST
#
# To use: when asking your company to send a message/notification,
# tell the agent: recipient = your Slack/Discord/Make.com webhook URL
# and action_type = "webhook".

# === Storage ===
# SQLite (default, local). Swap to postgresql+asyncpg://user:pass@host/db for production.
DATABASE_URL=sqlite+aiosqlite:///./dri_company.db

# === Workspace ===
# Directory where agents read/write files
WORKSPACE_DIR=./workspace

# === Orchestration ===
# Maximum number of agents running concurrently across the entire system
MAX_CONCURRENT_AGENTS=20
# Maximum depth of the agent hierarchy tree
MAX_SPAWN_DEPTH=10
# Seconds before a single agent task is considered timed out
# 600s recommended for shell-heavy tasks (bun install + bun run build can take 60-120s alone)
AGENT_TIMEOUT_SECONDS=600
